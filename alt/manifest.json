{
  "manifest_version": 2,
  "name": "The Mox Terminal Alt",
  "version": "0.3.0",
  "description": "A terminal-inspired Cyberpunk 2077 Mox theme using deep violet-black, magenta, ultraviolet, cyan, and cyber teal.",
  "author": "Firefox Theme",
  "icons": {
    "48": "assets/moxlogo.svg",
    "96": "assets/moxlogo.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "the-mox-terminal-alt@firefox-theme.local",
      "strict_min_version": "112.0"
    }
  },
  "theme": {
    "images": {
      "theme_frame": "assets/header-terminal.svg"
    },
    "colors": {
      "frame": "#0D0E15",
      "frame_inactive": "#120818",
      "toolbar": "#14091F",
      "toolbar_text": "#D5F8FF",
      "toolbar_field": "#0D0E15",
      "toolbar_field_text": "#D5F8FF",
      "toolbar_field_border": "#2B1750",
      "toolbar_field_focus": "#0D0E15",
      "toolbar_field_text_focus": "#FFFFFF",
      "toolbar_field_border_focus": "#FF007F",
      "toolbar_field_highlight": "#7000FF",
      "toolbar_field_highlight_text": "#FFFFFF",
      "toolbar_top_separator": "#14091F",
      "toolbar_bottom_separator": "#2B1750",
      "toolbar_vertical_separator": "#2B1750",
      "tab_background_text": "#8FB8C4",
      "tab_background_separator": "#2B1750",
      "tab_selected": "#14091F",
      "tab_text": "#FFFFFF",
      "tab_line": "#FF007F",
      "tab_loading": "#00F0FF",
      "bookmark_text": "#BDE9EE",
      "button_background_hover": "#2B1750",
      "button_background_active": "#4A1D8F",
      "icons": "#00F0FF",
      "icons_attention": "#FF007F",
      "sidebar": "#0D0E15",
      "sidebar_text": "#D5F8FF",
      "sidebar_border": "#2B1750",
      "sidebar_highlight": "#4A1D8F",
      "sidebar_highlight_text": "#FFFFFF",
      "popup": "#14091F",
      "popup_text": "#D5F8FF",
      "popup_border": "#2B1750",
      "popup_highlight": "#4A1D8F",
      "popup_highlight_text": "#FFFFFF",
      "ntp_background": "#0D0E15",
      "ntp_text": "#D5F8FF",
      "ntp_card_background": "#14091F"
    },
    "properties": {
      "color_scheme": "dark"
    }
  }
}
